              "section": "Psionic Powers: Resist Fatigue"
            },
            "text": "Self."
          },
          {
            "id": "metadata-1",
            "name": "Duration",
            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Resist Fatigue"
            },
            "text": "One hour plus 20 minutes per level of experience."
