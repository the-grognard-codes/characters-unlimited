            "name": "Saving Throw",
            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Empathy"
            },
            "text": "Standard each melee; a successful save obscures the target's emotions. Mind Block prevents emanations."
          }
        ],
        "source": {
          "book": "Rifts Ultimate Edition",
          "section": "Psionic Powers: Empathy"
        },
