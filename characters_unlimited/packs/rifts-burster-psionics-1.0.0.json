              "section": "Psionic Powers: Deaden Senses"
            },
            "text": "2D6 minutes; roll for random determination of duration."
          },
          {
            "id": "metadata-2",
            "name": "I.S.P.",
            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Deaden Senses"
            },
            "text": "4"
          },
          {
            "id": "metadata-3",
