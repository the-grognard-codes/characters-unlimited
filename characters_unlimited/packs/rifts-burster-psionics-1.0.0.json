            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Mind Block"
            },
            "text": "4 (per each duration period)."
          }
        ],
        "source": {
          "book": "Rifts Ultimate Edition",
          "section": "Psionic Powers: Mind Block"
        },
        "tags": [
          "Physical",
          "Sensitive"
