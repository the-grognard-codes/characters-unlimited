      {
        "category": "Healing",
        "description": "Meditation is a trance state of consciousness in which the individual can calm his emotions and focus on relaxation of mind and body. In a meditative state, the psychic finds peace and harmony between mind, body and spirit, and it is in this state of being that he can regenerate his Inner Strength (I.S.P.). Recovers Base I.S.P. at a rate as indicated under each psychic O.C.C., otherwise six I.S.P. per hour of meditation.",
        "id": "meditation",
        "name": "Meditation",
        "parameters": [
          {
            "id": "metadata-0",
            "name": "Range",
            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Meditation"
            },
            "text": "Self."
          },
          {
            "id": "metadata-1",
            "name": "Duration",
            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Meditation"
            },
            "text": "As needed; at least one hour of meditation is required."
          },
          {
            "id": "metadata-2",
            "name": "I.S.P.",
            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Meditation"
            },
            "text": "None, zero."
          }
        ],
        "source": {
          "book": "Rifts Ultimate Edition",
          "section": "Psionic Powers: Meditation"
        },
        "tags": [
          "Healing",
          "Physical",
          "Sensitive"
        ]
      },
      {
        "category": "Healing",
        "description": "A mind over matter discipline which enables the character to engage in physical activity without suffering from exhaustion. However, fatigue is only temporarily suspended, so the psychic feels extremely tired and may even collapse when the duration of this power elapses.",
        "id": "resist-fatigue",
        "name": "Resist Fatigue",
        "parameters": [
          {
            "id": "metadata-0",
            "name": "Range",
            "source": {
