      {
        "id": "machine-ghost",
        "name": "Machine Ghost",
        "category": "Sensitive",
        "tags": [
          "Sensitive"
        ],
        "source": {
          "book": "Rifts Ultimate Edition",
          "section": "Psionic Powers: Machine Ghost"
        },
        "description": "Read electronic information at ten times normal speed, including disks or damaged machines; cannot edit data or enter sentient self-aware machines. The trance leaves the body oblivious and undefended; Telepathy can communicate. Virtual defenders and viruses threaten the projection: virtual death or failure to find the exit before duration ends requires coma/death checks. Breaking ordinary file contact causes one melee at half actions/combat bonuses.",
        "parameters": [
          {
            "id": "metadata-0",
            "name": "Range",
            "text": "Self; computer by touch.",
            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Machine Ghost"
            }
          },
          {
            "id": "metadata-1",
            "name": "Duration",
            "text": "Three minutes per level of experience.",
            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Machine Ghost"
            }
          },
          {
            "id": "metadata-2",
            "name": "I.S.P.",
            "text": "12",
            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Machine Ghost"
            }
          },
          {
            "id": "metadata-3",
            "name": "Saving Throw",
            "text": "Not applicable.",
            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Machine Ghost"
            }
          }
        ]
      },
      {
        "id": "object-read",
        "name": "Object Read",
        "category": "Sensitive",
        "tags": [
          "Sensitive"
        ],
        "source": {
          "book": "Rifts - Ultimate Edition",
          "section": "Psi-Operator Object Read restriction; Psionic Powers: Object Read",
          "pages": [
            92
          ],
          "pdf_pages": [
            95
          ]
        },
        "description": "Class grant is limited to the history and operation of the device. Hold an object to seek impressions and images of its history and last owner; roll separately for each. Each psychic may read a given object only once, even after failure. A successful impression or image permits a present-time glimpse for an additional 4 ISP, with its own success check. Reading a possessed object exposes the psychic to psychic attacks without saving bonuses.",
        "parameters": [
          {
            "id": "metadata-0",
            "name": "Range",
            "text": "Touch.",
            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Object Read"
            }
          },
          {
            "id": "metadata-1",
            "name": "Duration",
            "text": "Varies; usually about 2D6 minutes.",
            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Object Read"
            }
          },
          {
            "id": "metadata-2",
            "name": "I.S.P.",
            "text": "6",
            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Object Read"
            }
          },
          {
            "id": "metadata-3",
            "name": "Saving Throw",
            "text": "None.",
            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Object Read"
            }
          },
          {
            "id": "metadata-4",
            "name": "Base Skill",
            "text": "Impressions: 56% +2% per level of experience. Images: 48% +2% per level. Present: 38% +2% per level of experience.",
            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Object Read"
            }
          }
        ]
      },
      {
        "id": "resist-fatigue",
        "name": "Resist Fatigue",
        "category": "Healing",
        "tags": [
          "Healing",
          "Physical"
        ],
        "source": {
          "book": "Rifts Ultimate Edition",
          "section": "Psionic Powers: Resist Fatigue"
        },
        "description": "A mind over matter discipline which enables the character to engage in physical activity without suffering from exhaustion. However, fatigue is only temporarily suspended, so the psychic feels extremely tired and may even collapse when the duration of this power elapses.",
        "parameters": [
          {
            "id": "metadata-0",
            "name": "Range",
            "text": "Self.",
            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Resist Fatigue"
            }
          },
          {
            "id": "metadata-1",
            "name": "Duration",
            "text": "One hour plus 20 minutes per level of experience.",
            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Resist Fatigue"
            }
          },
          {
            "id": "metadata-2",
            "name": "Length of Trance",
            "text": "1D6 melees of preparatory meditation.",
            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Resist Fatigue"
            }
          },
          {
            "id": "metadata-3",
            "name": "I.S.P.",
            "text": "4",
            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Resist Fatigue"
            }
          }
        ]
      },
