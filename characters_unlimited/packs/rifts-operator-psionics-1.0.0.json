      {
        "id": "sense-time",
        "name": "Sense Time",
        "category": "Sensitive",
        "tags": [
          "Sensitive"
        ],
        "source": {
          "book": "Rifts Ultimate Edition",
          "section": "Psionic Powers: Sense Time"
        },
        "description": "The psychic is able to accurately measure the passage of time, down to within 1D4 seconds. This can be useful when in an environment where the passage of time can be lost, and especially when the character must meet with or do something at a precise moment in time, like gauging exactly when a bomb will detonate, when a switch must be turned on or off, and so on.",
        "parameters": [
          {
            "id": "metadata-0",
            "name": "Range",
            "text": "Self.",
            "source": {
              "book": "Rifts Ultimate Edition",
              "section": "Psionic Powers: Sense Time"
            }
          },
          {
            "id": "metadata-1",
